{
  "name": "mindguard-ai",
  "version": "1.0.0",
  "description": "MindGuard AI – Early Mental Wellness Warning & Support System",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,teal\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run dev",
    "test": "npm --prefix backend test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
